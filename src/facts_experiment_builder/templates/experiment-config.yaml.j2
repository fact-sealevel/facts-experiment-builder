
### Experiment configuration YAML file ###
# This is the main configuration file that describes the specified FACTS experiment.
# It is generated with prepopulated keys based on the modules you specified in `setup-new-experiment`.
# The values included here are default values specified in this module's entry in the FACTS module registry (https://github.com/fact-sealevel/facts-module-registry).

# **About this file:**
# This file has three sections:
# - The first section includes experiment-level information such as top-level parameter values, the modules and workflows included in the experiment, and paths to input and output data. 
# - The second section includes values for module-specific options for each module included in the experiment. 
# - The third section contains the module schema for each module included in the experiment. This is extracted from the module registry entry for a module using the state of the module registry at the time the experiment was created.

# **How to use this file:**
# 1. Fill in the desired values for the top-level parameters of the experiment.
# 2. Specify the location of the input data to be used in this experiment.
# 3. Specify the location file to be used in this experiment.
# 4. Review the module-level inputs, options, and outputs to ensure they are correct.

# **IMPORTANT**
# This file does not 'run' a FACTS experiment, it merely specifies an experiment. Once you have completed filling out this file, run:
# `uv run generate-compose <experiment_directorY> to generate a Docker Compose file that corresponds to this experiment.
# Then, run `docker compose -f <compose_file> up` to run the experiment.

# About this experiment:
# Date created: {{ date_created}}

experiment_name:
{{ format_value(experiment_name) }}

projection_scale:
{{ format_value(projection_scale) }}

##----- Top-level params -----##
{% for key, value in top_level_params.items() %}
{{ key }}:
{{ format_value(value) }}
{% endfor %}

##----- Modules included in experiment -----##
{% for module_key in included_modules %}
{% if module_key in manifest %}
{{ module_key }}:
{{ format_value(manifest[module_key]) }}
{% endif %}
{% endfor %}

##----- Workflows (facts-total) -----##
{% if workflows %}
workflows:
{% for wf_name, wf_modules in workflows.items() %}
  {{ wf_name }}: "{{ wf_modules }}"
{% endfor %}
{% endif %}

##----- Inputs -----##
{% for key in inputs %}
{% if key in paths %}
{{ key }}:
{{ format_value(paths[key]) }}
{% endif %}
{% endfor %}

##----- Outputs -----##
{% for key in outputs %}
{% if key in paths %}
{{ key }}:
{{ format_value(paths[key]) }}
{% endif %}
{% endfor %}


##--------------------------------------------------------##
##--------------------------------------------------------##
##----- Module-specific inputs, options, and outputs -----##
{% for module_key in module_keys %}
{{ module_key }}:
{{ format_module(module_key, module_sections[module_key]) }}
{% endfor %}


##--------------------------------------------------------##
##--------------------------------------------------------##
##----- Module schemas -----##
module_registry_version: #Version of module registry used to generate this experiment configuration file.
{{ format_value(module_registry_version) }}

module_schemas:
{% for module_key in module_keys %}
{% if module_key in module_schemas %}
  {{ module_key }}:
{{ format_module(module_key, module_schemas[module_key], indent=4) }}
{% endif %}
{% endfor %}
