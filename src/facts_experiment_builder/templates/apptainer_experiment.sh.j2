#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# FACTS Sea Level Experiment Runner - Apptainer
# Generated by facts-experiment-builder
# =============================================================================

# --- Paths -------------------------------------------------------------------
WORKSPACE="{{ workspace_dir }}"
DATA_DIR="${WORKSPACE}/data"
EXPERIMENT_NAME="{{ experiment_name }}"
OUTPUT_DIR="{{ output_dir }}"
SHARED_IN="{{ shared_in }}"
MODULE_IN="{{ module_in }}"
SIF_DIR="{{ sif_dir }}"

# --- Global params -----------------------------------------------------------
PYEAR_START={{ pyear_start }}
PYEAR_END={{ pyear_end }}
PYEAR_STEP={{ pyear_step }}
BASEYEAR={{ baseyear }}
SCENARIO="{{ scenario }}"
NSAMPS={{ nsamps }}
PIPELINE_ID="{{ pipeline_id }}"
{% if workflow_vars %}
{% for wf_name, var_name in workflow_vars %}
{{ var_name }}="{{ wf_name }}"
{% endfor %}
{% endif %}

# --- Helpers -----------------------------------------------------------------

log() { echo "[$(date '+%H:%M:%S')] $*"; }

pull_image() {
    local name="$1"
    local ref="$2"
    local sif="${SIF_DIR}/${name}.sif"
    if [[ ! -f "$sif" ]]; then
        log "Pulling ${ref} -> ${sif}"
        apptainer pull --disable-cache "$sif" "docker://${ref}"
    else
        log "Image already exists: ${sif}"
    fi
}

run_service() {
    local name="$1"
    local sif="${SIF_DIR}/${name}.sif"
    shift
    log "Running service: ${name}"
    apptainer run \
        --no-home \
        --containall \
        "${BINDS[@]}" \
        "$sif" \
        "$@"
    log "Completed: ${name}"
}

wait_for_output() {
    # Poll until an expected output file exists (used to gate stage 2)
    local file="$1"
    local service="$2"
    log "Waiting for output of ${service}: ${file}"
    local attempts=0
    until [[ -f "$file" ]]; do
        sleep 5
        attempts=$((attempts + 1))
        if (( attempts > 360 )); then   # 30-minute timeout
            echo "ERROR: Timed out waiting for ${file}" >&2
            exit 1
        fi
    done
    log "Output ready: ${file}"
}

# --- Setup -------------------------------------------------------------------
mkdir -p \
    "${SIF_DIR}" \
{% for d in mkdir_dirs %}
    "{{ d }}"{{ " \\" if not loop.last else "" }}
{% endfor %}

# --- Pull images -------------------------------------------------------------
log "=== Pulling images ==="
{% for spec in all_specs %}
pull_image "{{ spec.service_name }}-{{ spec.image_tag }}" "{{ spec.image_ref }}"
{% endfor %}

# =============================================================================
# Stage 1: Climate module + non-climate-dependent sealevel modules
# =============================================================================
log "=== Stage 1: independent services ==="
{% for spec in stage1 %}

# --- {{ spec.service_name }} ---
BINDS=(
{% for bind in spec.binds %}
    "--bind={{ bind }}"
{% endfor %}
)
run_service "{{ spec.service_name }}-{{ spec.image_tag }}" \
{% for arg in spec.args[:-1] %}
    "{{ arg }}" \
{% endfor %}
    "{{ spec.args[-1] }}"
{% endfor %}

{% if stage2 %}
# =============================================================================
# Stage 2: Sealevel modules depending on climate output
# =============================================================================
log "=== Stage 2: services depending on climate step ==="
{% for file in climate_wait_files %}
wait_for_output "{{ file }}" "{{ climate_service_name }}"
{% endfor %}
{% for spec in stage2 %}

# --- {{ spec.service_name }} ---
BINDS=(
{% for bind in spec.binds %}
    "--bind={{ bind }}"
{% endfor %}
)
run_service "{{ spec.service_name }}-{{ spec.image_tag }}" \
{% for arg in spec.args[:-1] %}
    "{{ arg }}" \
{% endfor %}
    "{{ spec.args[-1] }}"
{% endfor %}

{% endif %}
{% if stage3 %}
# =============================================================================
# Stage 3: Totaling step (parallel, one per workflow × output type)
# =============================================================================
log "=== Stage 3: facts-total ==="

BINDS=(
{% for bind in stage3[0].binds %}
    "--bind={{ bind }}"
{% endfor %}
)
{% for spec in stage3 %}
run_service "{{ spec.service_name }}-{{ spec.image_tag }}" \
{% for arg in spec.args[:-1] %}
    "{{ arg }}" \
{% endfor %}
    "{{ spec.args[-1] }}" &
{{ spec.pid_var }}=$!

{% endfor %}
{% for spec in stage3 %}
wait ${{ spec.pid_var }} || { echo "ERROR: {{ spec.service_name }} failed" >&2; exit 1; }
{% endfor %}

{% endif %}
{% if stage4 %}
# =============================================================================
# Stage 4: ESL (sequential)
# =============================================================================
log "=== Stage 4: ESL ==="
{% for spec in stage4 %}

# --- {{ spec.service_name }} ---
BINDS=(
{% for bind in spec.binds %}
    "--bind={{ bind }}"
{% endfor %}
)
run_service "{{ spec.service_name }}-{{ spec.image_tag }}" \
{% for arg in spec.args[:-1] %}
    "{{ arg }}" \
{% endfor %}
    "{{ spec.args[-1] }}"
{% endfor %}

{% endif %}
log "Experiment complete."
